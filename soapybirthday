<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>For Soappyyy 🫧</title>

<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Great+Vibes&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

html,body{
  width:100%;
  height:100%;
  overflow:hidden;
  background:#020611;
  color:white;
  font-family:'Montserrat',sans-serif;
}

body{
  position:relative;
}

:root{
  --blue:#4da3ff;
  --blue2:#8ac7ff;
  --glass:rgba(5,14,31,.62);
  --line:rgba(125,190,255,.28);
}

/* ================= BACKGROUND ================= */

body:before{
  content:"";
  position:fixed;
  inset:-20%;
  background:
    radial-gradient(circle at 18% 20%,rgba(30,110,255,.17),transparent 28%),
    radial-gradient(circle at 78% 35%,rgba(0,75,180,.15),transparent 32%),
    radial-gradient(circle at 50% 100%,rgba(35,105,220,.12),transparent 30%);
  filter:blur(10px);
  z-index:0;
}

#stars{
  position:fixed;
  inset:0;
  pointer-events:none;
  z-index:1;
}

.star{
  position:absolute;
  width:2px;
  height:2px;
  background:white;
  border-radius:50%;
  opacity:.65;
  animation:twinkle 3s infinite ease-in-out;
}

@keyframes twinkle{
  0%,100%{
    opacity:.12;
    transform:scale(.7);
  }
  50%{
    opacity:.9;
    transform:scale(1.5);
  }
}

/* ================= BIG BLUE BUTTERFLY ================= */

.butterfly-field{
  position:fixed;
  inset:0;
  pointer-events:none;
  z-index:2;
  overflow:hidden;
}

.butterfly{
  position:absolute;
  width:220px;
  height:180px;
  opacity:.78;
  filter:drop-shadow(0 0 22px rgba(40,145,255,.8));
  animation:fly 12s ease-in-out infinite;
}

.butterfly .wing{
  position:absolute;
  width:105px;
  height:145px;
  border-radius:75% 25% 65% 35%;
  background:
    linear-gradient(
      135deg,
      rgba(125,205,255,.92),
      rgba(24,93,220,.65) 48%,
      rgba(8,27,91,.72)
    );
  border:1px solid rgba(180,230,255,.5);
}

.butterfly .left{
  left:5px;
  top:0;
  transform:rotate(-25deg);
}

.butterfly .right{
  right:5px;
  top:0;
  transform:scaleX(-1) rotate(-25deg);
}

.butterfly .lower{
  width:80px;
  height:85px;
  top:82px;
  border-radius:30% 70% 45% 55%;
  opacity:.72;
}

.butterfly .l2{
  left:28px;
  transform:rotate(25deg);
}

.butterfly .r2{
  right:28px;
  transform:scaleX(-1) rotate(25deg);
}

.butterfly .body{
  position:absolute;
  left:50%;
  top:38px;
  transform:translateX(-50%);
  width:11px;
  height:105px;
  border-radius:50%;
  background:linear-gradient(#dff5ff,#1d5fbc 65%,#07152d);
}

.butterfly .antenna{
  position:absolute;
  width:55px;
  height:35px;
  top:15px;
  border-top:2px solid #9ddcff;
  border-radius:50%;
}

.butterfly .a1{
  left:42px;
  transform:rotate(-25deg);
}

.butterfly .a2{
  right:42px;
  transform:scaleX(-1) rotate(-25deg);
}

@keyframes fly{
  0%,100%{
    transform:translate(-10vw,8vh) rotate(-3deg) scale(.8);
  }

  25%{
    transform:translate(18vw,25vh) rotate(7deg) scale(1);
  }

  50%{
    transform:translate(45vw,-2vh) rotate(-6deg) scale(1.08);
  }

  75%{
    transform:translate(70vw,22vh) rotate(5deg) scale(.95);
  }
}

/* ================= PAGES ================= */

.page{
  position:absolute;
  inset:0;
  display:none;
  z-index:5;
  overflow-y:auto;
  padding:34px 22px 90px;
  scrollbar-width:none;
}

.page::-webkit-scrollbar{
  display:none;
}

.page.active{
  display:block;
  animation:pageIn .8s ease;
}

@keyframes pageIn{
  from{
    opacity:0;
    transform:scale(.985);
  }

  to{
    opacity:1;
    transform:none;
  }
}

.center{
  min-height:calc(100vh - 80px);
  display:flex;
  align-items:center;
  justify-content:center;
}

.glass{
  width:min(760px,94vw);
  padding:40px 30px;
  border:1px solid var(--line);
  border-radius:28px;
  background:
    linear-gradient(
      135deg,
      rgba(7,19,42,.74),
      rgba(2,8,20,.54)
    );
  backdrop-filter:blur(18px);
  box-shadow:
    0 0 55px rgba(25,110,255,.12),
    inset 0 1px rgba(255,255,255,.08);
}

.kicker{
  font-size:11px;
  letter-spacing:4px;
  text-transform:uppercase;
  color:#8fcaff;
  margin-bottom:15px;
}

h1,h2{
  font-family:Cinzel,serif;
  font-weight:500;
}

h1{
  font-size:clamp(34px,6vw,68px);
  line-height:1.05;
}

h2{
  font-size:clamp(26px,4vw,45px);
}

.script{
  font-family:"Great Vibes",cursive;
  color:#a9d8ff;
  font-size:clamp(30px,5vw,52px);
}

.sub{
  margin-top:16px;
  color:#c9d9ec;
  line-height:1.8;
  font-size:14px;
}

.small{
  font-size:12px;
  color:#89a4c2;
  line-height:1.8;
}

/* ================= PASSWORD ================= */

input{
  width:min(370px,100%);
  padding:15px 18px;
  border-radius:999px;
  border:1px solid rgba(120,190,255,.45);
  background:rgba(0,0,0,.34);
  color:white;
  outline:none;
  text-align:center;
  margin-top:25px;
}

input:focus{
  box-shadow:0 0 25px rgba(45,140,255,.2);
}

.btn{
  margin-top:15px;
  padding:13px 28px;
  border-radius:999px;
  border:1px solid rgba(110,190,255,.55);
  background:rgba(30,105,205,.18);
  color:white;
  cursor:pointer;
  transition:.25s;
}

.btn:hover{
  background:rgba(45,135,255,.3);
  transform:translateY(-2px);
}

.error{
  height:22px;
  color:#8dcaff;
  font-size:12px;
  margin-top:10px;
}

/* ================= NAV ================= */

.nav{
  position:fixed;
  z-index:30;
  bottom:18px;
  left:50%;
  transform:translateX(-50%);
  display:flex;
  gap:8px;
  padding:8px;
  border:1px solid rgba(120,190,255,.18);
  background:rgba(2,8,20,.72);
  backdrop-filter:blur(14px);
  border-radius:999px;
}

.nav button{
  border:0;
  background:transparent;
  color:#9ab3d0;
  padding:8px 11px;
  border-radius:999px;
  cursor:pointer;
  font-size:12px;
}

.nav button:hover,
.nav button.current{
  background:rgba(70,145,235,.18);
  color:white;
}

/* ================= COUNTDOWN ================= */

.countdown{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:10px;
  margin:30px 0;
}

.timebox{
  padding:18px 8px;
  border:1px solid rgba(110,185,255,.25);
  border-radius:18px;
  background:rgba(3,12,28,.55);
  text-align:center;
}

.timebox b{
  display:block;
  font-family:Cinzel;
  font-size:clamp(24px,5vw,44px);
  color:#c6e6ff;
  font-weight:500;
}

.timebox span{
  font-size:10px;
  letter-spacing:2px;
  color:#7898bb;
  text-transform:uppercase;
}

@media(max-width:600px){
  .countdown{
    grid-template-columns:repeat(2,1fr);
  }
}

/* ================= STORY ================= */

.story-grid{
  width:min(1050px,96vw);
  margin:auto;
  display:grid;
  grid-template-columns:1.1fr .9fr;
  gap:22px;
  align-items:stretch;
}

.story-card{
  padding:32px;
  border:1px solid var(--line);
  border-radius:25px;
  background:rgba(3,10,23,.62);
  backdrop-filter:blur(14px);
}

.story-card p{
  color:#c9d7e8;
  line-height:1.95;
  font-size:14px;
  margin-top:18px;
}

.quote{
  border-left:2px solid #4da3ff;
  padding-left:18px;
  margin-top:25px;
  color:#b9dcff;
  font-family:"Great Vibes";
  font-size:29px;
}

@media(max-width:780px){
  .story-grid{
    grid-template-columns:1fr;
  }
}

/* ================= GIF ================= */

.gifbox{
  width:min(380px,85vw);
  margin:25px auto;
  border:1px solid rgba(120,190,255,.25);
  border-radius:22px;
  overflow:hidden;
  background:rgba(0,0,0,.25);
}

.tenor-gif-embed{
  max-width:100%!important;
}

/* ================= LETTER ================= */

.letter{
  width:min(820px,94vw);
  margin:auto;
  min-height:70vh;
  padding:42px 35px;
  border:1px solid rgba(130,200,255,.25);
  border-radius:26px;
  background:
    linear-gradient(
      145deg,
      rgba(7,19,39,.83),
      rgba(2,8,18,.74)
    );
  box-shadow:0 0 50px rgba(35,120,255,.1);
}

.letter-text{
  margin-top:28px;
  color:#d9e8f7;
  font-size:15px;
  line-height:2.05;
  white-space:pre-wrap;
}

.cursor{
  display:inline-block;
  width:7px;
  height:18px;
  background:#86caff;
  animation:blink .7s infinite;
  vertical-align:-3px;
}

@keyframes blink{
  50%{
    opacity:0;
  }
}

/* ================= FINAL ================= */

.final{
  min-height:75vh;
  display:flex;
  align-items:center;
  justify-content:center;
  text-align:center;
}

.final h1{
