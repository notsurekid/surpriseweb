  <button onclick="go(5)">05</button>
  <button onclick="go(6)">06</button>

</div>


<script>

/* ================= STARS ================= */

const stars =
document.getElementById("stars");

for(let i=0;i<110;i++){

  const s=document.createElement("i");

  s.className="star";

  s.style.left =
    Math.random()*100+"%";

  s.style.top =
    Math.random()*100+"%";

  s.style.animationDelay =
    (Math.random()*3)+"s";

  s.style.opacity =
    (.15+Math.random()*.65);

  stars.appendChild(s);
}


/* ================= PASSWORD ================= */

let unlocked=false;

function unlock(){

  const value =
    document
    .getElementById("password")
    .value
    .trim()
    .toLowerCase();

  if(value==="soap"){

    unlocked=true;

    document
    .getElementById("error")
    .textContent="";

    document
    .getElementById("nav")
    .style.display="flex";

    go(2);

  }else{

    document
    .getElementById("error")
    .textContent=
      "Wrong password… try again.";

  }

}


document
.getElementById("password")
.addEventListener(
  "keydown",
  e=>{
    if(e.key==="Enter"){
      unlock();
    }
  }
);


/* ================= PAGE NAVIGATION ================= */

function go(n){

  if(!unlocked && n!==1)
    return;

  document
  .querySelectorAll(".page")
  .forEach(
    p=>p.classList.remove("active")
  );

  document
  .getElementById("p"+n)
  .classList.add("active");

  document
  .querySelectorAll(".nav button")
  .forEach(
    (b,i)=>
      b.classList.toggle(
        "current",
        i===n-1
      )
  );

  if(n===5){
    startLetter();
  }

}


/* ================= COUNTDOWN ================= */

/*
   LAKSHYA'S BIRTHDAY:
   26 SEPTEMBER 2026
*/

const birthday =
  new Date(
    "2026-09-26T00:00:00+05:30"
  );


function countdown(){

  let diff =
    birthday-new Date();

  if(diff<0)
    diff=0;

  const d =
    Math.floor(
      diff/86400000
    );

  const h =
    Math.floor(
      diff/3600000
    )%24;

  const m =
    Math.floor(
      diff/60000
    )%60;

  const s =
    Math.floor(
      diff/1000
    )%60;


  document
  .getElementById("days")
  .textContent =
    String(d).padStart(2,"0");

  document
  .getElementById("hours")
  .textContent =
    String(h).padStart(2,"0");

  document
  .getElementById("mins")
  .textContent =
    String(m).padStart(2,"0");

  document
  .getElementById("secs")
  .textContent =
    String(s).padStart(2,"0");

}

countdown();

setInterval(
  countdown,
  1000
);


/* ================= LETTER ================= */

const letterText =

`I don't really know where to start, but I just wanted to make this little corner of the internet for you.

You have been one of the most special people in my life, and even though things aren't the same between us right now, that doesn't make the memories disappear.

I hope you're happy. I hope you're healthy. I hope you find people who genuinely understand you, and I hope life gives you more reasons to smile than reasons to worry.

I still remember the random names, the stupid arguments, the laughs, and the way hearing your voice could instantly make a normal moment feel different.

And honestly, if our paths ever cross again in the future, I'd be happy to see where life takes us.

For now, I just want you to know that you matter to me, and I will always wish good things for you.

Happy Birthday, Lakshya.

With lots of love,
Your Issue-Tissue ♡`;


let letterStarted=false;


function startLetter(){

  if(letterStarted)
    return;

  letterStarted=true;

  const box =
    document.getElementById("letter");

  const words =
    letterText.split(/(\s+)/);

  let i=0;


  function type(){

    if(i<words.length){

      box.innerHTML +=
        words[i];

      i++;

      setTimeout(
        type,
        words[i-1].trim()===""
        ?22
        :42
      );

    }else{

      box.innerHTML +=
        '<span class="cursor"></span>';

    }

  }

  type();

}

</script>


